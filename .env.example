CI_ENV=development
BASE_URL=http://localhost:8079/
APP_PORT=8079

# Database Configuration (Docker container name is 'db')
DB_HOST=db
DB_PORT=3306
DB_NAME=polman_pelayanan
DB_USER=root
DB_PASS=root
DB_ROOT_PASSWORD=root

# Host Port for accessing MySQL from outside docker (e.g. DBeaver / HeidiSQL)
MYSQL_PORT=3307
